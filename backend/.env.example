# --- GQ service ---
GQ_PORT=4000
# Node env: development | staging | production
NODE_ENV=development

# --- Database ---
# GQ's gq_* tables (mappings, sync state, logs) live in the SAME physical database
# bq/backend and eq/backend use (see their own .env DATABASE_URL) - this is not a
# separate database. Point this at that same connection string.
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=bq

# --- GQ session/token signing (distinct from BQ/EQ's own JWT secret - never share) ---
GQ_JWT_SECRET=replace-with-a-long-random-secret
GQ_JWT_EXPIRES_IN_MINUTES=240

# --- Upstream: EQ (aq) service - used only for POST /aq/api/login during GQ login ---
AQ_BASE_URL=http://localhost:8000

# --- Upstream: BQ service - source of truth for property/hotel data ---
BQ_BASE_URL=http://localhost:9000

# --- Upstream: pricing-service - source of truth for rates (ARI push reads from here) ---
PRICING_SERVICE_BASE_URL=http://localhost:8001

# --- Upstream: Channex.io ---
# CHANNEX_ENVIRONMENT selects a known default base URL when CHANNEX_BASE_URL is not set.
# staging is documented by Channex (https://staging.channex.io/api/v1); production has not
# been confirmed from Channex's own docs as of this integration's research - set
# CHANNEX_BASE_URL explicitly for production rather than relying on a guessed default.
CHANNEX_ENVIRONMENT=staging
# CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=replace-with-real-channex-api-key

# Public origin Channex's webhook calls land on - GQ appends /api/gq/webhooks/channex
# itself, so set this to just the scheme+host (e.g. an ngrok tunnel in dev, the real
# domain in prod). No trailing slash.
PUBLIC_WEBHOOK_BASE_URL=https://your-public-host.example.com

# --- Outbound HTTP timeouts (ms) ---
UPSTREAM_TIMEOUT_MS=10000
